@page "/"
@using Microsoft.AspNetCore.SignalR.Client
@using Shared
@inject HttpClient Http

<PageTitle>System Zasobów</PageTitle>

<h1>Zarządzanie Zasobami</h1>

<div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 20px;">
    <h3>Dodaj zasób</h3>
    <input @bind="newResource.Name" placeholder="Nazwa sprzętu" />
    <select @bind="newResource.Status">
        <option>Dostępny</option>
        <option>W naprawie</option>
        <option>Zajęty</option>
    </select>
    <button @onclick="AddResource">Dodaj</button>
</div>

@if (resources == null)
{
    <p>Ładowanie...</p>
}
else
{
    <table class="table">
        <thead><tr><th>ID</th><th>Nazwa</th><th>Status</th><th>Akcja</th></tr></thead>
        <tbody>
            @foreach (var r in resources)
            {
                <tr style="@(r.Status == "W naprawie" ? "color:red" : "color:green")">
                    <td>@r.Id</td>
                    <td>@r.Name</td>
                    <td>@r.Status</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteResource(r.Id)">Usuń</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Resource>? resources;
    private Resource newResource = new Resource();
    private HubConnection? hubConnection;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        // SIGNALR - ODBIERANIE POWIADOMIEŃ (Wymóg 5)
        hubConnection = new HubConnectionBuilder()
            .WithUrl("http://localhost:5000/resourcehub") // Port serwera! Zmienimy go zaraz
            .Build();

        hubConnection.On("ReceiveUpdate", async () =>
        {
            await LoadData();
            StateHasChanged();
        });

        await hubConnection.StartAsync();
    }

    private async Task LoadData()
    {
        resources = await Http.GetFromJsonAsync<List<Resource>>("http://localhost:5000/Resources");
    }

    private async Task AddResource()
    {
        await Http.PostAsJsonAsync("http://localhost:5000/Resources", newResource);
        newResource = new Resource(); // Reset
    }
    private async Task DeleteResource(int id)
    {
      
        await Http.DeleteAsync($"http://localhost:5000/Resources/{id}");

    }
}